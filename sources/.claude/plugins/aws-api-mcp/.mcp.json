{
  "mcpServers": {
    "aws-api-mcp": {
      "command": "uvx",
      "args": ["--from", "awslabs.aws-api-mcp-server==1.3.46", "awslabs.aws-api-mcp-server"],
      "env": {
        "READ_OPERATIONS_ONLY": "true",
        "UV_CACHE_DIR": "${CLAUDE_CONFIG_DIR:-/tmp}/.uv-cache",
        "UV_PYTHON_PREFERENCE": "only-system"
      }
    }
  }
}
