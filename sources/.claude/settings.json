{
  "permissions": {
    "ask": [
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-docs-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "git-allowlist-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claude-format",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline",
    "refreshInterval": 2
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "disableRemoteControl": true,
  "feedbackDrafts": "off",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
    "skillOverrides": {
      "code-review": "off",
      "ultrareview": "off",
      "anthropic-skills:docs": "off",
      "anthropic-skills:docx": "off",
      "anthropic-skills:google-workspace": "off",
      "anthropic-skills:import-memory": "off",
      "anthropic-skills:morning": "off",
      "anthropic-skills:pptx": "off",
      "anthropic-skills:skill-creator": "off",
      "anthropic-skills:xlsx": "off"
    }
}
