export NIX_CONFIG="warn-dirty = false"

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# A changed flake.nix must not re-evaluate on the host by itself: the claude
# sandbox binds the cwd read-write, so flake.nix and devshells/ are writable
# from inside it, and the resulting shellHook would run in this shell on the
# next cd. Manual-reload mode keeps the cached env, prints a notice, and makes
# `nix-direnv-reload` (generated into .direnv/bin, which the sandbox cannot
# write) the explicit step — as `direnv allow` already is for .envrc.
if has nix_direnv_manual_reload; then
  nix_direnv_manual_reload
fi
